{
  "name": "dsh-context-kit",
  "version": "0.3.0",
  "description": "Compaction-threshold tuner for DeepSeek Harness: edits the agent preset (thresholdRatio / retainRatio) with provenance-safe patches, and shows measured usage. The context index now lives in dsh-token-trim.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LISHUANGXI1412/dsh-context-kit"
  },
  "author": "LISHUANGXI1412",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context",
    "compaction",
    "agent-preset",
    "tokens",
    "index"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./host.js",
    "./index-host": "./index.js",
    "./tuner": "./tuner.js",
    "./client": "./client/panel.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "index.js",
    "tuner.js",
    "lib/",
    "bin/",
    "client/",
    "vendor/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-context-kit": "./bin/dsh-context-kit.mjs"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  }
}
